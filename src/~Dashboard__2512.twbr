      <repository-location derived-from='https://public.tableau.com/workbooks/IDIVPrj_17912825451450/2_Vung_GioLam?rev=' id='133862693' path='/workbooks/IDIVPrj_17912825451450' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='mental_health' name='federated.1yobjml1vq9twv157oky00whbuln' />
          </datasources>
          <datasource-dependencies datasource='federated.1yobjml1vq9twv157oky00whbuln'>
            <column caption='Nhóm giờ làm ' datatype='string' name='[Calculation_0095434320322560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [work_hours_per_week] &lt;= 40 THEN &quot;1. ≤40&quot;&#13;&#10;ELSEIF [work_hours_per_week] &lt;= 45 THEN &quot;2. 41-45&quot;&#13;&#10;ELSEIF [work_hours_per_week] &lt;= 50 THEN &quot;3. 46-50&quot;&#13;&#10;ELSEIF [work_hours_per_week] &lt;= 55 THEN &quot;4. 51-55&quot;&#13;&#10;ELSEIF [work_hours_per_week] &lt;= 60 THEN &quot;5. 56-60&quot;&#13;&#10;ELSE &quot;6. &gt;60&quot; &#13;&#10;END' />
              <aliases>
                <alias key='&quot;1. ≤40&quot;' value=' ≤40' />
                <alias key='&quot;2. 41-45&quot;' value='41-45' />
                <alias key='&quot;3. 46-50&quot;' value='46-50' />
                <alias key='&quot;4. 51-55&quot;' value='51-55' />
                <alias key='&quot;5. 56-60&quot;' value='56-60' />
                <alias key='&quot;6. &gt;60&quot;' value='&gt;60' />
              </aliases>
            </column>
            <column caption='Nhóm giờ ngủ' datatype='string' name='[Calculation_0095434320416769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sleep_hours_per_night] &lt;= 5 THEN &quot;1) ≤5 giờ&quot;&#13;&#10;ELSEIF [sleep_hours_per_night] &lt;= 6 THEN &quot;2) 5-6 giờ&quot;&#13;&#10;ELSEIF [sleep_hours_per_night] &lt;= 7 THEN &quot;3) 6-7 giờ&quot;&#13;&#10;ELSEIF [sleep_hours_per_night] &lt;= 8 THEN &quot;4) 7-8 giờ&quot;&#13;&#10;ELSE &quot;5) &gt;8 giờ&quot; END' />
              <aliases>
                <alias key='&quot;1) ≤5 giờ&quot;' value='≤5 giờ' />
                <alias key='&quot;2) 5-6 giờ&quot;' value='5-6 giờ' />
                <alias key='&quot;3) 6-7 giờ&quot;' value='6-7 giờ' />
                <alias key='&quot;4) 7-8 giờ&quot;' value='7-8 giờ' />
                <alias key='&quot;5) &gt;8 giờ&quot;' value='&gt;8 giờ' />
              </aliases>
            </column>
            <column caption='Nhóm deadline ' datatype='string' name='[Calculation_0095434320523266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [deadline_pressure_score] &lt;= 2 THEN &quot;1) 0-2&quot;&#13;&#10;ELSEIF [deadline_pressure_score] &lt;= 4 THEN &quot;2) 2-4&quot;&#13;&#10;ELSEIF [deadline_pressure_score] &lt;= 6 THEN &quot;3) 4-6&quot;&#13;&#10;ELSEIF [deadline_pressure_score] &lt;= 8 THEN &quot;4) 6-8&quot;&#13;&#10;ELSE &quot;5) 8-10&quot; END' />
              <aliases>
                <alias key='&quot;1) 0-2&quot;' value=' 0-2' />
                <alias key='&quot;2) 2-4&quot;' value=' 2-4' />
                <alias key='&quot;3) 4-6&quot;' value='4-6' />
                <alias key='&quot;4) 6-8&quot;' value='6-8' />
                <alias key='&quot;5) 8-10&quot;' value=' 8-10' />
              </aliases>
            </column>
            <column caption='KPI % burnout cao ' datatype='real' name='[Calculation_0773557572694021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [burnout_level] IN (&quot;High&quot;,&quot;Severe&quot;) THEN 1 ELSE 0 END)&#13;&#10;/ COUNT([employee_id])' />
            </column>
            <column caption='Ai Tools Daily' datatype='string' datatype-customized='true' name='[ai_tools_daily]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;0&quot;' value='Không dùng AI' />
                <alias key='&quot;1&quot;' value='Dùng AI' />
              </aliases>
            </column>
            <column caption='Burnout Level' datatype='string' name='[burnout_level]' role='dimension' type='nominal' />
            <column caption='Deadline Pressure Score' datatype='real' name='[deadline_pressure_score]' role='measure' type='quantitative' />
            <column aggregation='Count' caption='Employee Id' datatype='integer' name='[employee_id]' role='measure' type='quantitative' />
            <column caption='Gad7 Category' datatype='string' name='[gad7_category]' role='dimension' type='nominal' />
            <column caption='Job Role' datatype='string' name='[job_role]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0095434320322560]' derivation='None' name='[none:Calculation_0095434320322560:nk]' pivot='key' type='nominal' />
            <column-instance column='[burnout_level]' derivation='None' name='[none:burnout_level:nk]' pivot='key' type='nominal' />
            <column caption='Seniority Level' datatype='string' name='[seniority_level]' role='dimension' type='nominal' />

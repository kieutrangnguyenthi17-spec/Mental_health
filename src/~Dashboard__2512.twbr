          <datasource-dependencies datasource='federated.1yobjml1vq9twv157oky00whbuln'>
            <column caption='Nhóm cân bằng cuộc sống' datatype='string' name='[Calculation_0773557592117257]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [work_life_balance_ratio] &lt;= 1.2105 THEN &quot;Nhóm 01 &#13;&#10;(Tỷ số ≤ 1.21)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.3125 THEN &quot;Nhóm 02 &#13;&#10;(1.21 – 1.31)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.3929 THEN &quot;Nhóm 03 &#13;&#10;(1.31 – 1.39)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.4688 THEN &quot;Nhóm 04 &#13;&#10;(1.39 – 1.47)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.5429 THEN &quot;Nhóm 05 &#13;&#10;(1.47 – 1.54)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.6226 THEN &quot;Nhóm 06 &#13;&#10;(1.54 – 1.62)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.7143 THEN &quot;Nhóm 07 &#13;&#10;(1.62 – 1.71)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.8367 THEN &quot;Nhóm 08 &#13;&#10;(1.71 – 1.84)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 2.0000 THEN &quot;Nhóm 09 &#13;&#10;(1.84 – 2.00)&quot;&#13;&#10;ELSE &quot;Nhóm 10 &#13;&#10;(Tỷ số &gt; 2.00)&quot;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Nhóm 01&quot;' value='Nhóm 01 (Tỷ số ≤ 1.21)' />
              </aliases>
            </column>
            <column caption='Hotroyte' datatype='string' name='[Calculation_0773557606166538]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [seeks_mental_health_support] = 1 AND [uses_therapy] = 1 THEN &quot;Cả hai&quot;&#13;&#10;ELSEIF [seeks_mental_health_support] = 1 AND [uses_therapy] = 0 THEN &quot;Chỉ tìm hỗ trợ&quot;&#13;&#10;ELSEIF [seeks_mental_health_support] = 0 AND [uses_therapy] = 1 THEN &quot;Chỉ trị liệu&quot;&#13;&#10;ELSE &quot;Không có hỗ trợ nào&quot;&#13;&#10;END' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_0773557606981644]' role='measure' type='quantitative' user:unnamed='04_MentalRisk'>

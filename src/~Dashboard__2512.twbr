        </title>
      </layout-options>
      <repository-location derived-from='https://public.tableau.com/workbooks/IDIVPrj_17912825451450/5?rev=' id='133971586' path='/workbooks/IDIVPrj_17912825451450' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='burnout_tableau_data' name='federated.0bwvat51iik6he10p3kio1yywgpv' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Ngưỡng Cảnh Báo Severe' datatype='real' name='[Parameter 0192468140748800]' param-domain-type='range' role='measure' type='quantitative' value='0.30000000000000004'>
              <calculation class='tableau' formula='0.30000000000000004' />
              <range granularity='0.05' max='1.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0bwvat51iik6he10p3kio1yywgpv'>
            <column caption='Alt Prediction' datatype='string' name='[Alt_Prediction]' role='dimension' type='nominal' />
            <column caption='Nhãn Dự Đoán Động' datatype='string' name='[Calculation_0192468141154305]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Prob_Severe] &gt;= [Parameters].[Parameter 0192468140748800] THEN &#13;&#10;    &quot;Severe&quot; &#13;&#10;ELSE &#13;&#10;    [Alt_Prediction] &#13;&#10;END' />
            </column>
            <column caption='Cấp bậc' datatype='string' name='[Calculation_0192468142915587]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [categorical__seniority_level_Junior] = 1 THEN &#13;&#10;    &quot;Junior&quot;&#13;&#10;ELSEIF [categorical__seniority_level_Mid] = 1 THEN &#13;&#10;    &quot;Mid&quot;&#13;&#10;ELSEIF [categorical__seniority_level_Senior] = 1 THEN &#13;&#10;    &quot;Senior&quot;&#13;&#10;ELSEIF [categorical__seniority_level_Lead] = 1 THEN &#13;&#10;    &quot;Lead&quot;&#13;&#10;ELSEIF [categorical__seniority_level_Manager] = 1 THEN &#13;&#10;    &quot;Manager&quot;&#13;&#10;ELSE &#13;&#10;    &quot;Principal&quot;&#13;&#10;END' />
            </column>
            <column caption='Work Mode' datatype='string' name='[Calculation_0192468185509900]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [categorical__work_mode_Hybrid] = 1 THEN &quot;Hybrid&quot;&#13;&#10;ELSEIF [categorical__work_mode_On-site] = 1 THEN &quot;On-site&quot;&#13;&#10;ELSEIF [categorical__work_mode_Remote] = 1 THEN &quot;Remote&quot;&#13;&#10;END' />
            </column>
            <column caption='Prob Severe' datatype='real' name='[Prob_Severe]' role='measure' type='quantitative' />
            <column caption='Burnout Level' datatype='string' name='[burnout_level]' role='dimension' type='nominal' />
            <column datatype='real' name='[categorical__seniority_level_Junior]' role='measure' type='quantitative' />
            <column datatype='real' name='[categorical__seniority_level_Lead]' role='measure' type='quantitative' />
            <column datatype='real' name='[categorical__seniority_level_Manager]' role='measure' type='quantitative' />
            <column datatype='real' name='[categorical__seniority_level_Mid]' role='measure' type='quantitative' />
            <column datatype='real' name='[categorical__seniority_level_Senior]' role='measure' type='quantitative' />
            <column datatype='real' name='[categorical__work_mode_Hybrid]' role='measure' type='quantitative' />
            <column datatype='real' name='[categorical__work_mode_On-site]' role='measure' type='quantitative' />
            <column datatype='real' name='[categorical__work_mode_Remote]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0192468141154305]' derivation='None' name='[none:Calculation_0192468141154305:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0192468142915587]' derivation='None' name='[none:Calculation_0192468142915587:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0192468185509900]' derivation='None' name='[none:Calculation_0192468185509900:nk]' pivot='key' type='nominal' />
            <column-instance column='[burnout_level]' derivation='None' name='[none:burnout_level:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0192468141154305]' derivation='Count' name='[pcto:cnt:Calculation_0192468141154305:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.0bwvat51iik6he10p3kio1yywgpv].[Calculation_0192468141154305]' ordering-type='Field' type='PctTotal' />
            </column-instance>
          </datasource-dependencies>
          <manual-sort column='[federated.0bwvat51iik6he10p3kio1yywgpv].[none:Calculation_0192468141154305:nk]' direction='ASC'>
            <dictionary>

              <bucket>&quot;Moderate (10-14)&quot;</bucket>
              <bucket>&quot;Severe (15-21)&quot;</bucket>
              <bucket>%all%</bucket>
            </dictionary>
          </manual-sort>
          <slices>
            <column>[federated.1yobjml1vq9twv157oky00whbuln].[none:burnout_level:nk]</column>
            <column>[federated.1yobjml1vq9twv157oky00whbuln].[Action (Nhóm giờ làm )]</column>

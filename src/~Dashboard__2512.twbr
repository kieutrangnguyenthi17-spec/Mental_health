            <column aggregation='Count' caption='Employee Id' datatype='integer' name='[employee_id]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0773557606166538]' derivation='None' name='[none:Calculation_0773557606166538:nk]' pivot='key' type='nominal' />
            <column-instance column='[burnout_level]' derivation='None' name='[none:burnout_level:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />

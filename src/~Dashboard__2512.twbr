          </manual-sort>
          <filter class='categorical' column='[federated.1yobjml1vq9twv157oky00whbuln].[none:burnout_level:nk]' context='true' filter-group='3'>
            <groupfilter function='level-members' level='[none:burnout_level:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <manual-sort column='[federated.1yobjml1vq9twv157oky00whbuln].[none:gad7_category:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Minimal (0-4)&quot;</bucket>

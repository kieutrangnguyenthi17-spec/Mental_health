            <column caption='KPI Số nhân sự ' datatype='integer' name='[Calculation_0773557572583428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([employee_id])' />
            </column>
            <column caption='KPI % burnout cao ' datatype='real' name='[Calculation_0773557572694021]' role='measure' type='quantitative'>

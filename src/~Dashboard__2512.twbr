          </filter>
          <filter class='categorical' column='[federated.1yobjml1vq9twv157oky00whbuln].[Action (Nhóm giờ làm )]'>
            <groupfilter function='level-members' level='[Calculation_0095434320322560]' user:ui-action-filter='[Action7_BA12A74EF9BE4487922895777B619D15]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1yobjml1vq9twv157oky00whbuln].[Action (Nhóm giờ làm ,Nhóm giờ ngủ)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action10_0279EA8F286B49B1BD4C920C60201BA1]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[Calculation_0095434320322560]' />

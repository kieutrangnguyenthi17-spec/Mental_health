          <manual-sort column='[federated.1yobjml1vq9twv157oky00whbuln].[none:Calculation_0095434320416769:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;5) &gt;8 giờ&quot;</bucket>
              <bucket>&quot;4) 7-8 giờ&quot;</bucket>
              <bucket>&quot;3) 6-7 giờ&quot;</bucket>
              <bucket>&quot;2) 5-6 giờ&quot;</bucket>
              <bucket>&quot;1) ≤5 giờ&quot;</bucket>

            <column caption='Nhóm giờ làm ' datatype='string' name='[Calculation_0095434320322560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [work_hours_per_week] &lt;= 40 THEN &quot;1. ≤40&quot;&#13;&#10;ELSEIF [work_hours_per_week] &lt;= 45 THEN &quot;2. 41-45&quot;&#13;&#10;ELSEIF [work_hours_per_week] &lt;= 50 THEN &quot;3. 46-50&quot;&#13;&#10;ELSEIF [work_hours_per_week] &lt;= 55 THEN &quot;4. 51-55&quot;&#13;&#10;ELSEIF [work_hours_per_week] &lt;= 60 THEN &quot;5. 56-60&quot;&#13;&#10;ELSE &quot;6. &gt;60&quot; &#13;&#10;END' />
              <aliases>

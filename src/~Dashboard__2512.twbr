      <column caption='Recall (Severe)' datatype='real' name='[Calculation_0192468150845448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0192468150185988]) / (SUM([Calculation_0192468150185988]) + SUM([Calculation_0192468150341638]))' />

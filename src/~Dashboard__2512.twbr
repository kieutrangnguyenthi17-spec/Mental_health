            <column caption='Nhóm deadline ' datatype='string' name='[Calculation_0095434320523266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [deadline_pressure_score] &lt;= 2 THEN &quot;1) 0-2&quot;&#13;&#10;ELSEIF [deadline_pressure_score] &lt;= 4 THEN &quot;2) 2-4&quot;&#13;&#10;ELSEIF [deadline_pressure_score] &lt;= 6 THEN &quot;3) 4-6&quot;&#13;&#10;ELSEIF [deadline_pressure_score] &lt;= 8 THEN &quot;4) 6-8&quot;&#13;&#10;ELSE &quot;5) 8-10&quot; END' />
              <aliases>

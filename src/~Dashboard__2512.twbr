          <datasource-dependencies datasource='federated.1yobjml1vq9twv157oky00whbuln'>
            <column caption='Nhóm giờ làm ' datatype='string' name='[Calculation_0095434320322560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [work_hours_per_week] &lt;= 40 THEN &quot;1. ≤40&quot;&#13;&#10;ELSEIF [work_hours_per_week] &lt;= 45 THEN &quot;2. 41-45&quot;&#13;&#10;ELSEIF [work_hours_per_week] &lt;= 50 THEN &quot;3. 46-50&quot;&#13;&#10;ELSEIF [work_hours_per_week] &lt;= 55 THEN &quot;4. 51-55&quot;&#13;&#10;ELSEIF [work_hours_per_week] &lt;= 60 THEN &quot;5. 56-60&quot;&#13;&#10;ELSE &quot;6. &gt;60&quot; &#13;&#10;END' />
              <aliases>
                <alias key='&quot;1. ≤40&quot;' value=' ≤40' />
                <alias key='&quot;2. 41-45&quot;' value='41-45' />
                <alias key='&quot;3. 46-50&quot;' value='46-50' />
                <alias key='&quot;4. 51-55&quot;' value='51-55' />
                <alias key='&quot;5. 56-60&quot;' value='56-60' />
                <alias key='&quot;6. &gt;60&quot;' value='&gt;60' />
              </aliases>
            </column>
            <column caption='Nhóm giờ ngủ' datatype='string' name='[Calculation_0095434320416769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sleep_hours_per_night] &lt;= 5 THEN &quot;1) ≤5 giờ&quot;&#13;&#10;ELSEIF [sleep_hours_per_night] &lt;= 6 THEN &quot;2) 5-6 giờ&quot;&#13;&#10;ELSEIF [sleep_hours_per_night] &lt;= 7 THEN &quot;3) 6-7 giờ&quot;&#13;&#10;ELSEIF [sleep_hours_per_night] &lt;= 8 THEN &quot;4) 7-8 giờ&quot;&#13;&#10;ELSE &quot;5) &gt;8 giờ&quot; END' />
              <aliases>
                <alias key='&quot;1) ≤5 giờ&quot;' value='≤5 giờ' />
                <alias key='&quot;2) 5-6 giờ&quot;' value='5-6 giờ' />
                <alias key='&quot;3) 6-7 giờ&quot;' value='6-7 giờ' />
                <alias key='&quot;4) 7-8 giờ&quot;' value='7-8 giờ' />
                <alias key='&quot;5) &gt;8 giờ&quot;' value='&gt;8 giờ' />
              </aliases>

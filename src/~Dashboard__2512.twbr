    <worksheet name='KPI_2'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Arial' fontsize='8'>% Kiệt sức cao</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://public.tableau.com/workbooks/IDIVPrj_17912825451450/KPI_2?rev=' id='133862687' path='/workbooks/IDIVPrj_17912825451450' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='mental_health' name='federated.1yobjml1vq9twv157oky00whbuln' />
          </datasources>
          <datasource-dependencies datasource='federated.1yobjml1vq9twv157oky00whbuln'>
            <column caption='KPI % burnout cao ' datatype='real' name='[Calculation_0773557572694021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [burnout_level] IN (&quot;High&quot;,&quot;Severe&quot;) THEN 1 ELSE 0 END)&#13;&#10;/ COUNT([employee_id])' />
            </column>
            <column caption='Nhóm cân bằng cuộc sống' datatype='string' name='[Calculation_0773557592117257]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [work_life_balance_ratio] &lt;= 1.2105 THEN &quot;Nhóm 01 &#13;&#10;(Tỷ số ≤ 1.21)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.3125 THEN &quot;Nhóm 02 &#13;&#10;(1.21 – 1.31)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.3929 THEN &quot;Nhóm 03 &#13;&#10;(1.31 – 1.39)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.4688 THEN &quot;Nhóm 04 &#13;&#10;(1.39 – 1.47)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.5429 THEN &quot;Nhóm 05 &#13;&#10;(1.47 – 1.54)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.6226 THEN &quot;Nhóm 06 &#13;&#10;(1.54 – 1.62)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.7143 THEN &quot;Nhóm 07 &#13;&#10;(1.62 – 1.71)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.8367 THEN &quot;Nhóm 08 &#13;&#10;(1.71 – 1.84)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 2.0000 THEN &quot;Nhóm 09 &#13;&#10;(1.84 – 2.00)&quot;&#13;&#10;ELSE &quot;Nhóm 10 &#13;&#10;(Tỷ số &gt; 2.00)&quot;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Nhóm 01&quot;' value='Nhóm 01 (Tỷ số ≤ 1.21)' />
              </aliases>
            </column>
            <column caption='Hotroyte' datatype='string' name='[Calculation_0773557606166538]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [seeks_mental_health_support] = 1 AND [uses_therapy] = 1 THEN &quot;Cả hai&quot;&#13;&#10;ELSEIF [seeks_mental_health_support] = 1 AND [uses_therapy] = 0 THEN &quot;Chỉ tìm hỗ trợ&quot;&#13;&#10;ELSEIF [seeks_mental_health_support] = 0 AND [uses_therapy] = 1 THEN &quot;Chỉ trị liệu&quot;&#13;&#10;ELSE &quot;Không có hỗ trợ nào&quot;&#13;&#10;END' />
            </column>
            <column caption='Burnout Level' datatype='string' name='[burnout_level]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column aggregation='Count' caption='Employee Id' datatype='integer' name='[employee_id]' role='measure' type='quantitative' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column caption='Seeks Mental Health Support' datatype='integer' name='[seeks_mental_health_support]' role='measure' type='quantitative' />
            <column caption='Seniority Level' datatype='string' name='[seniority_level]' role='dimension' type='nominal' />
            <column caption='Uses Therapy' datatype='integer' name='[uses_therapy]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0773557572694021]' derivation='User' name='[usr:Calculation_0773557572694021:qk]' pivot='key' type='quantitative' />
            <column caption='Work Life Balance Ratio' datatype='real' name='[work_life_balance_ratio]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1yobjml1vq9twv157oky00whbuln].[Action (Country)]'>
            <groupfilter function='level-members' level='[country]' user:ui-action-filter='[Action2_01361033ABDC4B71905402F9B279D63E]' user:ui-enumeration='all' user:ui-marker='enumerate' />

      <column datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE(ATTR([employee_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([employee_id]) / TOTAL(COUNT([employee_id]))'>
          <table-calc ordering-field='[federated.1yobjml1vq9twv157oky00whbuln].[phq9_category]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Nhóm giờ làm ' datatype='string' name='[Calculation_0095434320322560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [work_hours_per_week] &lt;= 40 THEN &quot;1. ≤40&quot;&#13;&#10;ELSEIF [work_hours_per_week] &lt;= 45 THEN &quot;2. 41-45&quot;&#13;&#10;ELSEIF [work_hours_per_week] &lt;= 50 THEN &quot;3. 46-50&quot;&#13;&#10;ELSEIF [work_hours_per_week] &lt;= 55 THEN &quot;4. 51-55&quot;&#13;&#10;ELSEIF [work_hours_per_week] &lt;= 60 THEN &quot;5. 56-60&quot;&#13;&#10;ELSE &quot;6. &gt;60&quot; &#13;&#10;END' />
        <aliases>
          <alias key='&quot;1. ≤40&quot;' value=' ≤40' />
          <alias key='&quot;2. 41-45&quot;' value='41-45' />
          <alias key='&quot;3. 46-50&quot;' value='46-50' />
          <alias key='&quot;4. 51-55&quot;' value='51-55' />
          <alias key='&quot;5. 56-60&quot;' value='56-60' />
          <alias key='&quot;6. &gt;60&quot;' value='&gt;60' />
        </aliases>
      </column>
      <column caption='Nhóm giờ ngủ' datatype='string' name='[Calculation_0095434320416769]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [sleep_hours_per_night] &lt;= 5 THEN &quot;1) ≤5 giờ&quot;&#13;&#10;ELSEIF [sleep_hours_per_night] &lt;= 6 THEN &quot;2) 5-6 giờ&quot;&#13;&#10;ELSEIF [sleep_hours_per_night] &lt;= 7 THEN &quot;3) 6-7 giờ&quot;&#13;&#10;ELSEIF [sleep_hours_per_night] &lt;= 8 THEN &quot;4) 7-8 giờ&quot;&#13;&#10;ELSE &quot;5) &gt;8 giờ&quot; END' />
        <aliases>
          <alias key='&quot;1) ≤5 giờ&quot;' value='≤5 giờ' />
          <alias key='&quot;2) 5-6 giờ&quot;' value='5-6 giờ' />
          <alias key='&quot;3) 6-7 giờ&quot;' value='6-7 giờ' />
          <alias key='&quot;4) 7-8 giờ&quot;' value='7-8 giờ' />
          <alias key='&quot;5) &gt;8 giờ&quot;' value='&gt;8 giờ' />
        </aliases>
      </column>
      <column caption='Nhóm deadline ' datatype='string' name='[Calculation_0095434320523266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [deadline_pressure_score] &lt;= 2 THEN &quot;1) 0-2&quot;&#13;&#10;ELSEIF [deadline_pressure_score] &lt;= 4 THEN &quot;2) 2-4&quot;&#13;&#10;ELSEIF [deadline_pressure_score] &lt;= 6 THEN &quot;3) 4-6&quot;&#13;&#10;ELSEIF [deadline_pressure_score] &lt;= 8 THEN &quot;4) 6-8&quot;&#13;&#10;ELSE &quot;5) 8-10&quot; END' />
        <aliases>
          <alias key='&quot;1) 0-2&quot;' value=' 0-2' />
          <alias key='&quot;2) 2-4&quot;' value=' 2-4' />
          <alias key='&quot;3) 4-6&quot;' value='4-6' />
          <alias key='&quot;4) 6-8&quot;' value='6-8' />
          <alias key='&quot;5) 8-10&quot;' value=' 8-10' />
        </aliases>
      </column>
      <column caption='Cấp bậc' datatype='real' name='[Calculation_0192468142747650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [categorical_seniority_level_Junior] == 1 THEN &#13;&#10;    &quot;Junior&quot;&#13;&#10;ELSEIF [categorical_seniority_level_Mid] == 1 THEN &#13;&#10;    &quot;Mid&quot;&#13;&#10;ELSEIF [categorical_seniority_level_Senior] == 1 THEN &#13;&#10;    &quot;Senior&quot;&#13;&#10;ELSEIF [categorical_seniority_level_Lead] == 1 THEN &#13;&#10;    &quot;Lead&quot;&#13;&#10;ELSEIF [categorical_seniority_level_Manager] == 1 THEN &#13;&#10;    &quot;Manager&quot;&#13;&#10;ELSE &#13;&#10;    &quot;Principal&quot;&#13;&#10;END' />
      </column>
      <column caption='KPI % trị liệu' datatype='real' default-format='p0.00%' name='[Calculation_0516547986591744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([uses_therapy]) / COUNT([employee_id])' />
      </column>
      <column caption='KPI % tìm hỗ trợ' datatype='real' name='[Calculation_0516547987832833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([seeks_mental_health_support]) / COUNT([employee_id])' />
      </column>
      <column caption='KPI % PHQ-9 từ 10' datatype='real' default-format='p0.00%' name='[Calculation_0516547993321474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [phq9_score] &gt;= 10 THEN 1 ELSE 0 END) / COUNT([employee_id])' />
      </column>
      <column caption='KPI % GAD-7 từ 10' datatype='real' default-format='p0.00%' name='[Calculation_0516547993403395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [gad7_score] &gt;= 10 THEN 1 ELSE 0 END) / COUNT([employee_id])' />
      </column>
      <column caption='Nhóm quy mô mẫu' datatype='string' name='[Calculation_0773557564026880]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNT([employee_id]) &lt; 5000 THEN &quot;Dưới 5.000&quot;&#13;&#10;ELSEIF COUNT([employee_id]) &lt; 10000 THEN &quot;5.000 - 10.000&quot;&#13;&#10;ELSEIF COUNT([employee_id]) &lt; 25000 THEN &quot;10.000 - 25.000&quot;&#13;&#10;ELSE &quot;Trên 25.000&quot; END' />
      </column>
      <column caption='% burnout cao ' datatype='real' default-format='p0.00%' name='[Calculation_0773557564571649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [burnout_level] = &quot;High&quot; OR [burnout_level] = &quot;Severe&quot; THEN 1 ELSE 0 END)&#13;&#10;/ COUNT([employee_id])' />
      </column>
      <column caption='% có ý định nghỉ việc ' datatype='real' default-format='p0.00%' name='[Calculation_0773557564792835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([job_change_intention])' />
      </column>
      <column caption='KPI Số nhân sự ' datatype='integer' name='[Calculation_0773557572583428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([employee_id])' />
      </column>
      <column caption='KPI % burnout cao ' datatype='real' name='[Calculation_0773557572694021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [burnout_level] IN (&quot;High&quot;,&quot;Severe&quot;) THEN 1 ELSE 0 END)&#13;&#10;/ COUNT([employee_id])' />
      </column>
      <column caption='KPI % nguy cơ trầm cảm lo âu ' datatype='real' name='[Calculation_0773557572767750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [phq9_score] &gt;= 10 OR [gad7_score] &gt;= 10 THEN 1 ELSE 0 END)&#13;&#10;/ COUNT([employee_id])' />
      </column>
      <column caption='KPI % nghỉ việc ' datatype='real' name='[Calculation_0773557572841479]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([job_change_intention]) / COUNT([employee_id])' />
      </column>
      <column caption='KPI % trị liệu nhóm burnout cao' datatype='real' name='[Calculation_0773557572923400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [burnout_level] IN (&quot;High&quot;,&quot;Severe&quot;) AND [uses_therapy] = 1 THEN 1 ELSE 0 END)&#13;&#10;/ SUM(IF [burnout_level] IN (&quot;High&quot;,&quot;Severe&quot;) THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Nhóm cân bằng cuộc sống' datatype='string' name='[Calculation_0773557592117257]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [work_life_balance_ratio] &lt;= 1.2105 THEN &quot;Nhóm 01 &#13;&#10;(Tỷ số ≤ 1.21)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.3125 THEN &quot;Nhóm 02 &#13;&#10;(1.21 – 1.31)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.3929 THEN &quot;Nhóm 03 &#13;&#10;(1.31 – 1.39)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.4688 THEN &quot;Nhóm 04 &#13;&#10;(1.39 – 1.47)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.5429 THEN &quot;Nhóm 05 &#13;&#10;(1.47 – 1.54)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.6226 THEN &quot;Nhóm 06 &#13;&#10;(1.54 – 1.62)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.7143 THEN &quot;Nhóm 07 &#13;&#10;(1.62 – 1.71)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 1.8367 THEN &quot;Nhóm 08 &#13;&#10;(1.71 – 1.84)&quot;&#13;&#10;ELSEIF [work_life_balance_ratio] &lt;= 2.0000 THEN &quot;Nhóm 09 &#13;&#10;(1.84 – 2.00)&quot;&#13;&#10;ELSE &quot;Nhóm 10 &#13;&#10;(Tỷ số &gt; 2.00)&quot;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;Nhóm 01&quot;' value='Nhóm 01 (Tỷ số ≤ 1.21)' />
        </aliases>
      </column>
      <column caption='Hotroyte' datatype='string' name='[Calculation_0773557606166538]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [seeks_mental_health_support] = 1 AND [uses_therapy] = 1 THEN &quot;Cả hai&quot;&#13;&#10;ELSEIF [seeks_mental_health_support] = 1 AND [uses_therapy] = 0 THEN &quot;Chỉ tìm hỗ trợ&quot;&#13;&#10;ELSEIF [seeks_mental_health_support] = 0 AND [uses_therapy] = 1 THEN &quot;Chỉ trị liệu&quot;&#13;&#10;ELSE &quot;Không có hỗ trợ nào&quot;&#13;&#10;END' />
      </column>
